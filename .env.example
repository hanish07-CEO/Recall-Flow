# ============================================================================
# RecallFlow — Environment Variables Configuration
# ============================================================================
# Public URLs & collection names are pre-filled below.
# Private account credentials (QDRANT_API_KEY, LYZR_API_KEY, OMI_API_KEY)
# belong to your personal cloud accounts and should be added in the
# AI Studio "Secrets" panel (or your local .env file).
# ============================================================================

# 1. Application Base URLs (Pre-filled with AI Studio App URLs)
NEXT_PUBLIC_APP_URL="https://ais-pre-wg5kpp625ikigouyqpzyv7-22240150497.asia-southeast1.run.app"
VITE_APP_URL="https://ais-pre-wg5kpp625ikigouyqpzyv7-22240150497.asia-southeast1.run.app"
APP_URL="https://ais-pre-wg5kpp625ikigouyqpzyv7-22240150497.asia-southeast1.run.app"

# 2. Omi Voice Input & Developer API (https://docs.omi.me & https://api.omi.me)
# Pre-filled Omi Developer API Base URL and RecallFlow Webhook Receiver URL:
OMI_API_BASE_URL="https://api.omi.me/v1/dev"
OMI_WEBHOOK_URL="https://ais-pre-wg5kpp625ikigouyqpzyv7-22240150497.asia-southeast1.run.app/api/omi/webhook"
# Fetch from Omi App -> Settings -> Developer Mode -> Developer API Keys:
OMI_API_KEY=""
OMI_WEBHOOK_SECRET=""

# 3. Qdrant Persistent Vector Memory (https://qdrant.tech/documentation/)
# Pre-filled collection names used by RecallFlow:
QDRANT_COLLECTION_MEMORIES="recallflow_memories"
QDRANT_COLLECTION_ACTION_ITEMS="recallflow_action_items"
# Fetch from Qdrant Cloud Console (https://cloud.qdrant.io -> Clusters & API Keys):
QDRANT_URL=""
QDRANT_API_KEY=""

# 4. Lyzr Multi-Agent Orchestration (https://docs.lyzr.ai/introduction)
# Pre-filled Lyzr Studio v3 Inference Endpoint:
LYZR_API_BASE_URL="https://agent-prod.studio.lyzr.ai/v3/inference/chat/"
# Fetch from Lyzr Studio (https://studio.lyzr.ai -> Open Agent -> Click "Agent API"):
LYZR_API_KEY=""
LYZR_AGENT_CONFIG_ID=""

# 5. Runtime Mode
# Set DEMO_MODE="false" once QDRANT_URL, QDRANT_API_KEY, and LYZR_API_KEY are set.
# When DEMO_MODE="true" (or when secrets are empty), RecallFlow runs deterministically
# with full simulated Omi, Qdrant, and Lyzr pipelines.
DEMO_MODE="true"

# 6. AI Studio Platform Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
